# Copy to .env and fill in. Everything is optional; without X keys the app runs in
# reminder mode (browser notification at slot time + copy-to-clipboard).

# Where to listen. Keep 127.0.0.1 on a laptop. On a VPS either put a reverse
# proxy in front (recommended) or set HOST=0.0.0.0 and APP_PASSWORD.
PORT=3000
HOST=127.0.0.1

# Optional. Host names the server answers to besides localhost, 127.0.0.1 and
# [::1] (which always work), comma-separated, as "host" or "host:port"
# (e.g. ALLOWED_HOSTS=posts.example.com). A request whose Host header names
# anything else gets 421. When empty, a server bound to 127.0.0.1 answers only
# to the local names (which defeats DNS rebinding), and any other bind address
# answers to every name. Set it behind a reverse proxy that passes the public
# name through (nginx: proxy_set_header Host $host).
ALLOWED_HOSTS=

# SQLite database and uploaded images live here.
DATA_DIR=./data

# Posting slots and timezone live in this JSON file (see README).
CONFIG_PATH=./config.json

# Optional. When set, every request must send HTTP Basic auth with this password
# (any username). Use it whenever the app is reachable from outside localhost.
APP_PASSWORD=

# X API v2 credentials (OAuth 1.0a user context). All four are required to publish.
# Developer portal -> your project -> your app -> "Keys and tokens".
# The app's "User authentication settings" must grant Read and Write permission
# BEFORE you generate the access token/secret, or posting fails with 401/403.
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional, display only: your @handle without the @ (the sidebar footer then
# reads "X API: connected as @handle").
X_HANDLE=
